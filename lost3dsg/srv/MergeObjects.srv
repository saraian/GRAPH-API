# Request
float32 max_distance       # metres, MUST be > 0 (GA-25: zero is refused, it does not mean "default" and cannot mean "off")
float32 min_similarity     # unitless, MUST be > 0 (same rule); config defaults live in config.py association.*
bool    dry_run            # se True, calcola ma non esegue il merge
---
# Response
bool     success
string   message
int32    merged_count
string   merge_log_json    # lista di dict con dettagli di ogni merge avvenuto
