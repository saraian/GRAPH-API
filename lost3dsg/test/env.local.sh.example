# Copy to env.local.sh (same directory) and fill in. env.local.sh is gitignored and must stay so:
# the Modal endpoint URL is a CREDENTIAL -- the deployed app exposes fastapi_endpoint with no proxy
# auth, so the URL alone spends the account's GPU budget (GA-319). live_run.sh sources env.local.sh
# and REFUSES to start a modal-backend run without it, by design: a fresh clone must not be able
# to run against someone's Modal account by accident.
#
#   cp env.local.sh.example env.local.sh && chmod 600 env.local.sh
#
# The URL is printed by `modal deploy lost3dsg/src/perception_module/cloud/modal_perception.py`
# as the "-predict" endpoint (the client derives "-health" from it).
export MODAL_PERCEPTION_URL=https://<workspace>--lost3dsg-predict.modal.run

# WHERE THE DATA LIVES. The launcher used to derive this as two levels above the checkout, which
# was right while the repository sat inside the workspace. It no longer does: from /DATA/GRAPH-API
# that computes to "/", the directory test passes, and a run writes its bundle to /runs and
# publishes maps to /maps where nobody looks. So it is set here, explicitly, and the launcher
# REFUSES a root that holds no maps/, runs/ or results/ rather than guessing.
export WORKSPACE_ROOT=/path/to/your/workspace   # <- FILL IN. Must hold maps/, runs/ and results/.

# WHERE THE MODELS ARE CACHED, on the host. This is the host side of the container's /models/hf
# mount, and the run is offline by default -- a missing model fails at the gate instead of being
# downloaded inside the first perception cycle. The layout under it must be the hub layout
# (a hub/ directory): a flat blobs-and-refs cache at the root is found by a file search and NOT by
# the loader, which reads $HF_HOME/hub and nothing else.
export HF_SHARED_CACHE=/path/to/your/hf_cache   # <- FILL IN. install.sh caches the models here.
