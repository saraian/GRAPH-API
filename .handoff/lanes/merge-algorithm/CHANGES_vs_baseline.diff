+def box_gap(a, b):
+    """Largest per-axis separation between two AABBs in metres; 0.0 when they intersect or touch."""
+    return max(0.0, max(a[0] - b[1], b[0] - a[1]), max(a[2] - b[3], b[2] - a[3]),
+               max(a[4] - b[5], b[4] - a[5]))
