  fused = None                           -> (0.0, 1.0, 0.0, 1.0, 0.0, 1.0)
  fused malformed {x_min only}           -> None
  fused with string values               -> (-0.1, 1.1, 0.0, 1.0, 0.0, 1.0)
  fused with None value                  -> None
  no fused, bbox None                    -> None
  fused ok, bbox None                    -> (-0.1, 1.1, 0.0, 1.0, 0.0, 1.0)
