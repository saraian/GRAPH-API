      "from": "room",
      "to": "geometry",
      "label": "same room or intersect",
      "role": "main"
    },
    {
      "from": "geometry",
      "to": "score",
      "label": "compatible",
      "role": "main"
    },
    {
      "from": "score",
      "to": "decide",
      "label": "total, streak",
      "role": "main"
    },
