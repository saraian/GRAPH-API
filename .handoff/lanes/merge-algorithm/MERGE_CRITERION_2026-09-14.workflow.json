      "from": "geometry",
      "to": "refuse_geometry",
      "label": "gap > 0.3",
      "role": "error"
    },
    {
      "from": "decide",
      "to": "hold",
      "label": "held, or 1 of 2",
      "role": "error"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Attribute channel (LSF)",
      "items": [
        "s = sum(w * term) / sum(w) over comparable terms (label .25, colour .36, material .24, description .15); abstain if no optional term",
        "llr = +2.0 * (s - .85) / .15 capped at 2.0 for s >= .85 (below the 2.996 threshold); -8 * (.85 - s) / .35 floored at -8 for s < .85; same_kind = exact base label"
      ]
    },
    {
      "dot": "emerald",
      "title": "Geometric and other channels",
      "items": [
        "overlap = log(V_map / V_larger) * containment, clipped +-8; no intersection -> gIoU <= 0 and separation (Mahalanobis LLR vs 1/V_map)",
        "co-visibility: VETO if one frame and 2D-disjoint, else abstain; room +-log(n_rooms); appearance = CLIP in a 45 degree cone; ontology OFF"
      ]
    },
    {
      "dot": "amber",
      "title": "Rule, persistence, keeper",
      "items": [
        "unwitnessed overlap: overlap > 0 AND same base label AND attributes measured, else HOLD; so same label + overlap evidence => merge, synonyms and cross-kind stay held",
        "commit: total >= log(20) = 2.996 on 2 consecutive sweeps; gate refusal or hold resets the streak; keeper by merge_rank keeps its OWN box; stale pair skipped; merged_count = applied"
      ]
    }
  ]
}