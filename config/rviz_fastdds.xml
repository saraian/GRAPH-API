<?xml version="1.0" encoding="UTF-8"?>
<!-- RViz runs in a separate container. Use UDP because its /dev/shm is
     isolated from the acquisition container even with host networking. -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>rviz_udp</transport_id>
      <type>UDPv4</type>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="rviz_udp" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>rviz_udp</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
